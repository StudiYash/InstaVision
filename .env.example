# InstaVision environment template
# Copy this file to .env when a component needs local configuration.
# Backend and Telegram components load these values from .env when available.
# Original inline placeholder values are preserved as fallbacks.
# Do not commit a real .env file.

# Telegram bot configuration
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_BOT_USERNAME=replace-with-your-telegram-bot-username
TELEGRAM_GROUP_CHAT_ID=replace-with-your-telegram-group-chat-id

# Image generation and editing API credentials
REPLICATE_API_TOKEN=replace-with-your-replicate-api-token
OPENAI_API_KEY=replace-with-your-openai-api-key
IMGBB_API_KEY=replace-with-your-imgbb-api-key

# Redis rate limiting and user status storage
REDIS_HOST=replace-with-your-redis-host
REDIS_PORT=replace-with-your-redis-port
REDIS_PASSWORD=replace-with-your-redis-password

# Email notifications and feedback
EMAIL_SENDER=replace-with-sender-email-address
EMAIL_RECEIVER=replace-with-receiver-email-address
EMAIL_APP_PASSWORD=replace-with-email-app-password

# Local output and metrics paths
# If left unset, supported components use repo-local runtime_outputs/ folders.
METRICS_WORKBOOK_PATH=runtime_outputs/metrics/instavision_metrics.xlsx
SDXL_LIGHTNING_OUTPUT_FOLDER=runtime_outputs/sdxl_lightning
FLUX_SCHNELL_OUTPUT_FOLDER=runtime_outputs/flux_schnell
DALLE3_OUTPUT_FOLDER=runtime_outputs/dalle3
GOOGLE_IMAGEN3_OUTPUT_FOLDER=runtime_outputs/google_imagen3
LOCAL_IMAGE_OUTPUT_FOLDER=runtime_outputs/local_images
INPUT_IMAGE_PATH=runtime_outputs/uploads/sample_input.png

# Watermark font
WATERMARK_FONT_PATH="Project Telegram Bot/Support Files/HIGHSENS 400.otf"
